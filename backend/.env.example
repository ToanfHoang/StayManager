# Sao chép thành .env và điền giá trị thật. KHÔNG commit file .env
NODE_ENV=development
PORT=4100
# SQLite – đường dẫn tương đối tính từ thư mục prisma/
DATABASE_URL="file:./data/staymanager.db"
JWT_SECRET="chuoi-bi-mat-dai-it-nhat-32-ky-tu"
JWT_EXPIRES_IN=12h
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# Tài khoản tạo bởi `npm run db:seed`
SEED_ADMIN_EMAIL=admin@staymanager.local
SEED_ADMIN_PASSWORD=
SEED_LANDLORD_EMAIL=chunha@staymanager.local
SEED_LANDLORD_PASSWORD=

# Scheduler thông báo tự động (giờ Asia/Ho_Chi_Minh)
SCHEDULER_ENABLED=true
SCHEDULER_CRON="0 7-21 * * *"


# Khóa AES-256 (base64, 32 byte) mã hóa mật khẩu Hunonic. Tạo 1 lần, KHÔNG đổi sau khi đã lưu tài khoản.
APP_ENCRYPTION_KEY=
# API không chính thức của app Hunonic (đọc số kWh công tơ ENTEC)
HUNONIC_API_URL=https://api.hunonicpro.com/v3/
